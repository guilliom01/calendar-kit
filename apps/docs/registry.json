{
	"$schema": "https://shadcn-svelte.com/schema/registry.json",
	"name": "calendar-kit",
	"homepage": "https://github.com/calendar-kit/calendar-kit",
	"aliases": {
		"lib": "#lib/registry/lib",
		"ui": "#lib/registry/ui",
		"components": "#lib/registry/components",
		"hooks": "#lib/registry/hooks",
		"utils": "#lib/utils"
	},
	"items": [
		{
			"name": "calendar-state",
			"type": "registry:lib",
			"title": "Calendar state",
			"description": "Reactive calendar state (Svelte 5 runes) shared through context, plus pointer drag helpers.",
			"dependencies": ["@calendar-kit/core", "@internationalized/date"],
			"registryDependencies": [],
			"files": [
				{
					"path": "src/lib/registry/lib/calendar-state.svelte.ts",
					"type": "registry:lib"
				},
				{
					"path": "src/lib/registry/lib/calendar-drag.ts",
					"type": "registry:lib"
				}
			]
		},
		{
			"name": "month-view",
			"type": "registry:ui",
			"title": "Month view",
			"description": "Month grid with all-day bars, timed events and a +N overflow per day.",
			"dependencies": ["@calendar-kit/core", "@internationalized/date"],
			"registryDependencies": ["utils", "./calendar-state.json"],
			"files": [
				{
					"path": "src/lib/registry/ui/month-view/month-view.svelte",
					"type": "registry:ui"
				},
				{
					"path": "src/lib/registry/ui/month-view/index.ts",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "time-grid",
			"type": "registry:ui",
			"title": "Time grid",
			"description": "Week and day views: hours, all-day row, overlapping events in columns and a now line.",
			"dependencies": ["@calendar-kit/core", "@internationalized/date"],
			"registryDependencies": ["utils", "./calendar-state.json"],
			"files": [
				{
					"path": "src/lib/registry/ui/time-grid/time-grid.svelte",
					"type": "registry:ui"
				},
				{
					"path": "src/lib/registry/ui/time-grid/index.ts",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "event-dialog",
			"type": "registry:ui",
			"title": "Event dialog",
			"description": "Dialog to create, edit and delete events: title, all-day, start, end and color.",
			"dependencies": ["@calendar-kit/core", "@internationalized/date"],
			"registryDependencies": [
				"button",
				"checkbox",
				"dialog",
				"input",
				"label",
				"utils",
				"./calendar-state.json"
			],
			"files": [
				{
					"path": "src/lib/registry/ui/event-dialog/event-dialog.svelte",
					"type": "registry:ui"
				},
				{
					"path": "src/lib/registry/ui/event-dialog/event-form.svelte",
					"type": "registry:ui"
				},
				{
					"path": "src/lib/registry/ui/event-dialog/index.ts",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "calendar",
			"type": "registry:ui",
			"title": "Calendar",
			"description": "Full calendar: toolbar, month, week and day views, drag and drop, event dialog, undo/redo.",
			"dependencies": ["@calendar-kit/core", "@internationalized/date", "@lucide/svelte"],
			"registryDependencies": [
				"button",
				"utils",
				"./calendar-state.json",
				"./month-view.json",
				"./time-grid.json",
				"./event-dialog.json"
			],
			"files": [
				{
					"path": "src/lib/registry/ui/calendar/calendar.svelte",
					"type": "registry:ui"
				},
				{
					"path": "src/lib/registry/ui/calendar/calendar-toolbar.svelte",
					"type": "registry:ui"
				},
				{
					"path": "src/lib/registry/ui/calendar/index.ts",
					"type": "registry:ui"
				}
			]
		}
	]
}
