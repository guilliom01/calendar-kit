{
	"name": "calendar-kit",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --filter '@calendar-kit/core' build && bun run --filter '@calendar-kit/docs' build",
		"test": "bun run --filter '@calendar-kit/core' test",
		"check": "bun run --filter '*' check",
		"lint": "prettier --check . && bun run --filter '@calendar-kit/docs' lint",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
