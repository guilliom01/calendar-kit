{
  "name": "@guilli/calendar-core",
  "version": "0.1.0",
  "description": "Framework-agnostic calendar logic: dates, recurrence, layout, interaction and state.",
  "keywords": [
    "calendar",
    "scheduler",
    "recurrence",
    "rrule",
    "icalendar",
    "events",
    "svelte",
    "shadcn"
  ],
  "homepage": "https://github.com/guilliom01/calendar-kit#readme",
  "bugs": {
    "url": "https://github.com/guilliom01/calendar-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilliom01/calendar-kit.git",
    "directory": "packages/core"
  },
  "author": "Willington Ortiz",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && publint",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4"
  },
  "devDependencies": {
    "publint": "^0.3.25",
    "rrule-temporal": "^2.2.9",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
